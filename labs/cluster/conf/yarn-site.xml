<?xml version="1.0" encoding="UTF-8"?>
<!-- yarn-site.xml：YARN 资源管理器的配置 -->
<configuration>
  <!-- ResourceManager 在 master 容器上 -->
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>master</value>
  </property>
  <!-- MapReduce 的 Shuffle 由 NodeManager 上的辅助服务提供 -->
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <!-- 每个 NodeManager 拿出多少内存和 CPU 核给 YARN 分配（按普通笔记本电脑设置） -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>2048</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>2</value>
  </property>
  <!-- 一个 Container 最少、最多能申请多少内存 -->
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>256</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>2048</value>
  </property>
  <!-- 实验环境内存小，关闭虚拟内存检查，避免任务被误杀 -->
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>
  <!-- 磁盘使用率超过这个百分比，NodeManager 就把自己标成 UNHEALTHY、不再接任务。
       默认 90，笔记本硬盘常常超过，实验环境放宽到 98.5 -->
  <property>
    <name>yarn.nodemanager.disk-health-checker.max-disk-utilization-per-disk-percentage</name>
    <value>98.5</value>
  </property>
  <!-- 汇总各节点的任务日志，作业结束后可以在网页上查看 -->
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.log.server.url</name>
    <value>http://master:19888/jobhistory/logs</value>
  </property>
  <!-- NodeManager 启动 Container 时传给它的环境变量 -->
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_HOME,PATH,LANG,TZ,HADOOP_MAPRED_HOME</value>
  </property>
</configuration>
